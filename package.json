{
  "name": "dsh-rule-of-law",
  "version": "1.0.0",
  "description": "法律至上：把 DSH 的道德/伦理表述全部替换为《中华人民共和国法律》框架——法定权限、法律保留、程序合法、效力层级，并在工具调用层做合法性提示与留痕。",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "law",
    "china",
    "compliance",
    "rule-of-law"
  ],
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "core",
    "locale",
    "icon.svg",
    "test",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./client.js"
  ],
  "scripts": {
    "test": "node test/smoke.test.mjs && node test/host.test.mjs && node test/client.test.mjs",
    "test:core": "node test/smoke.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:client": "node test/client.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
